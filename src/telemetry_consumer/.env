# Template. Copy to .env.local for local dev; .env.prod is filled in by deployment tooling.
#
# DATABASE_URL is how this process itself (a host process during MVP dev) reaches the main DB.
# SANDBOX_MAIN_DB_DSN is what gets injected into sandbox containers so load_n_telemetry can reach the SAME
# main DB over the shared `telemetry-net` docker network -- different hostname, same database.

ENVIRONMENT=local
DATABASE_URL=postgresql://app:app@localhost:5433/maindb
SANDBOX_MAIN_DB_DSN=postgresql://app:app@maindb:5432/maindb
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
