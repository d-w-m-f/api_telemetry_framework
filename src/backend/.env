# Template. Copy to .env.local for local dev; .env.prod is filled in by deployment tooling. Export these
# into the process environment before `mvn spring-boot:run` -- Spring reads them natively via the
# ${VAR:default} placeholders in application.yml, no extra library needed.

ENVIRONMENT=local
MAINDB_HOST=localhost
MAINDB_PORT=5432
MAINDB_NAME=maindb
MAINDB_USER=app
MAINDB_PASSWORD=app
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
PORT=8080
